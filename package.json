{
  "name": "bingo-comunitario",
  "version": "1.0.0",
  "description": "Sistema de bingo para eventos comunitarios: telao para projecao, painel do operador, sorteio de desempate transparente e relatorio de ganhadores em PostgreSQL.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup-db": "node database/setup.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0"
  },
  "keywords": [
    "bingo",
    "evento",
    "comunitario",
    "telao",
    "postgresql",
    "express",
    "nodejs"
  ],
  "author": "Eduardo Aquiles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardodev001/project-bingo-frafem-uniaoterceira.git"
  },
  "engines": {
    "node": ">=18"
  }
}